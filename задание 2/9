function transliterate(str) {
    let map = { 'а':'a', 'б':'b', 'в':'v', 'г':'g', 'д':'d', 'е':'e', 'ж':'zh', 'з':'z', 'и':'i', 'к':'k', 'л':'l', 'м':'m', 'н':'n', 'о':'o', 'п':'p', 'р':'r', 'с':'s', 'т':'t', 'у':'u', 'ф':'f', 'х':'h', 'ц':'ts', 'ч':'ch', 'ш':'sh', 'щ':'sch', 'ы':'y', 'э':'e', 'ю':'yu', 'я':'ya' };
    let res = "";
    for (let i = 0; i < str.length; i++) {
        let char = str[i].toLowerCase();
        res += map[char] !== undefined ? map[char] : str[i];
    }
    return res;
}
console.log(transliterate("Привет мир"));